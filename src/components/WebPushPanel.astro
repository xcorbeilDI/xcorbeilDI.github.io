<section class="tab-panel active" id="tab-webpush-existing" role="tabpanel">
  <p class="panel-title"><strong>Current index.html behavior (same actions):</strong></p>
  <div class="stack row-gap">
    <label for="email">Adresse courriel du contact</label>
    <input id="email" class="email-input" type="text" />
  </div>
  <div class="stack row-gap">
    <input
      type="button"
      value="Identifier le contact"
      onclick="webPushActions.identify()"
    />
    <input
      type="button"
      value="Reset identification"
      onclick="webPushActions.resetIdentify()"
    />
  </div>
  <div class="stack row-gap">
    <input
      type="button"
      value="Envoi du token fr"
      onclick="webPushActions.requestPermissionFr()"
    />
    <input
      type="button"
      value="Envoi du token en"
      onclick="webPushActions.requestPermissionEn()"
    />
  </div>
  <div class="stack row-gap">
    <input
      type="button"
      value="Valider isSubscribed"
      onclick="webPushActions.checkIsSubscribed()"
    />
    <input
      type="button"
      value="Valider isSupported"
      onclick="webPushActions.checkIsSupported()"
    />
    <input
      type="button"
      value="Valider isBlocked"
      onclick="webPushActions.checkIsBlocked()"
    />
  </div>
  <div class="stack row-gap toggle-row">
    <label for="ofsys-debug-toggle">
      <input id="ofsys-debug-toggle" type="checkbox" />
      Activer ofsysDebug=1 dans l'URL
    </label>
  </div>
  <p id="webpush-last-result" class="result-box result-info row-gap-lg">
    Latest: no command executed yet.
  </p>
</section>
