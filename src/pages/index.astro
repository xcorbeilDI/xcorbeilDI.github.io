---
import BaseLayout from "../layouts/BaseLayout.astro";
import WebPushPanel from "../components/WebPushPanel.astro";
import ApiPanel from "../components/ApiPanel.astro";
import NotesPanel from "../components/NotesPanel.astro";
import EcommercePanel from "../components/EcommercePanel.astro";
---

<BaseLayout title="QA Test Hub">
  <main class="page">
    <div class="hero-top">
      <p class="eyebrow">DI WebPush QA</p>
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        onclick="toggleTheme()"
        aria-pressed="false"
      >
        Dark Theme
      </button>
    </div>
    <h1>Notification Test Console</h1>
    <p class="subtitle">
      Hub de test statique pour valider rapidement les workflows WebPush.
    </p>

    <nav class="tab-bar" role="tablist" aria-label="Test tabs">
      <button class="tab active" data-tab="tab-webpush-existing" role="tab" aria-selected="true">
        WebPush Existing
      </button>
      <button class="tab" data-tab="tab-api" role="tab" aria-selected="false">
        API Smoke
      </button>
      <button class="tab" data-tab="tab-ecommerce" role="tab" aria-selected="false">
        Ecommerce
      </button>
      <button class="tab" data-tab="tab-notes" role="tab" aria-selected="false">
        Notes
      </button>
    </nav>

    <WebPushPanel />
    <ApiPanel />
    <EcommercePanel />
    <NotesPanel />
  </main>
</BaseLayout>
